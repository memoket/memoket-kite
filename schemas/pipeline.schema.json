{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KITE agent workflow definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "inputs", "stages"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/id"}
    },
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "skill", "tool", "needs", "inputs", "output", "acceptance"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "skill": {"type": "string", "pattern": "^skills/(?:[a-z0-9-]+/)+SKILL[.]md$"},
          "tool": {"$ref": "#/$defs/id"},
          "needs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "inputs": {
            "type": "object",
            "propertyNames": {"$ref": "#/$defs/id"},
            "additionalProperties": {"type": "string", "pattern": "^(input|stage)[.][a-z][a-z0-9_-]*$"}
          },
          "output": {"$ref": "#/$defs/id"},
          "acceptance": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
}
