{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KITE normalized conversation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "source", "segments", "metadata"],
  "properties": {
    "conversation_id": {"$ref": "#/$defs/text"},
    "source": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "title": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "source_date": {"type": "string", "format": "date"},
    "language": {"$ref": "#/$defs/text"},
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["segment_id", "text"],
        "properties": {
          "segment_id": {"$ref": "#/$defs/text"},
          "source_sentence_id": {"$ref": "#/$defs/text"},
          "is_self": {"type": "boolean"},
          "speaker_id": {"$ref": "#/$defs/text"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "text": {"$ref": "#/$defs/text"}
        }
      }
    },
    "metadata": {
      "type": "object", "required": ["source_reference"],
      "properties": {"source_reference": {"$ref": "#/$defs/text"}}
    }
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"}}
}
